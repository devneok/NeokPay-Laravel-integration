{
  "name": "devneok/neokpay-laravel",
  "description": "Laravel integration for NEOK Pay.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "devneok/neokpay-php": "^1.0.0-beta.2",
    "guzzlehttp/guzzle": "^7.0",
    "guzzlehttp/psr7": "^2.0",
    "illuminate/console": "^11.0 || ^12.0 || ^13.0",
    "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpstan/phpstan": "^2.2.14",
    "phpunit/phpunit": "^11.0",
    "larastan/larastan": "v3.12.1"
  },
  "autoload": {
    "psr-4": {
      "Neok\\Pay\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Neok\\Pay\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Neok\\Pay\\Laravel\\NeokPayServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "archive": {
    "exclude": [
      "/vendor", "/.git", "/.github", "/.env", "/.env.*",
      "/composer.lock", "/tests", "/phpunit.xml", "/phpstan.neon",
      "/.phpunit*", "/.phpstan*", "/coverage", "/.idea", "/.vscode",
      "/PHASE-*.md", "/SERVER-SANDBOX-PLAN.md", "/tmp", "/test-apps",
      "/composer.local.*", "*.bak", "*.backup", "*.orig", "*.rej", "*~"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
